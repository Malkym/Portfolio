{
  "id": "times-new-roman",
  "name": "Times New Roman",
  "description": "Classic — Times New Roman. Thème CV dérivé de « Monochrome Ink ».",
  "scheme": "light",
  "colors": {
    "primary": "#1a1a1a",
    "secondary": "#555555",
    "tertiary": "#999999",
    "bg": "#f4f4f2",
