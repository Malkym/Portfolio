    "surfaceAlt": "#eaeae6",
    "text": "#141414",
    "textMuted": "#6e6e6e",
    "border": "#d8d8d4",
    "accentGradient": "linear-gradient(135deg, #1a1a1a 0%, #999999 100%)"
  },
  "typography": {
    "heading": "'Times New Roman', serif",
    "body": "'Times New Roman', serif",
